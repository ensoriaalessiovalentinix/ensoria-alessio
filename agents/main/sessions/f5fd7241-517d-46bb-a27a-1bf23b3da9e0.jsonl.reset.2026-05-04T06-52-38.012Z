         <Outlet />\n        </main>\n      </div>\n    </div>\n  )\n}\n","path":"/Users/alessio/.openclaw/workspace/ensoria-ui/src/components/layout/AppLayout.tsx"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-pro","usage":{"input":59,"output":513,"cacheRead":72320,"cacheWrite":0,"totalTokens":72892,"cost":{"input":0.00010266000000000001,"output":0.00178524,"cacheRead":0.0104864,"cacheWrite":0,"total":0.0123743}},"stopReason":"toolUse","timestamp":1777841593905,"responseId":"5b7d8fd5-bfb6-4d1f-a433-ad976af41ec9"}}
