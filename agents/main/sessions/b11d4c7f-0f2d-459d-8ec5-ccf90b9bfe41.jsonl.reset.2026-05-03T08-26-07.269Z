{"type":"message","id":"ccf137ba","parentId":"8f44f7f2","timestamp":"2026-05-03T08:05:14.389Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now the layout components and pages. Let me create them.","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_00_eYbsNyPH57PV1Fi3UuDp3643","name":"write","arguments":{"content":"import React from 'react'\nimport { cn } from '../lib/utils'\n\nconst items = [\n  { icon: '🏠', label: 'Dashboard', path: '/' },\n  { icon: '👤', label: 'People', path: '/people' },\n  { icon: '📊', label: 'Projects', path: '/projects' },\n  { icon: '⚙️', label: 'Settings', path: '/settings' },\n]\n\nexport function Sidebar({ currentPath, onNavigate }: { currentPath: string; onNavigate: (p: string) => void }) {\n  return (\n    <aside className=\"w-56 border-r border-[#2a2a3a] bg-[#13131a] flex flex-col py-4\">\n      <div className=\"px-4 mb-6\">\n        <h1 className=\"text-lg font-bold text-violet-400\">Ensoria OS</h1>\n        <p className=\"text-xs text-[#9898b0] mt-0.5\">CRM System</p>\n      </div>\n      <nav className=\"flex-1 space-y-1 px-2\">\n        {items.map((item) => (\n          <button\n            key={item.path}\n            onClick={() => onNavigate(item.path)}\n            className={cn(\n              'w-full flex items-center gap-3 px-3 py-2 rounded-lg text-sm font-medium transition-colors',\n              currentPath === item.path\n                ? 'bg-violet-600/20 text-violet-300'\n                : 'text-[#9898b0] hover:text-[#e4e4ec] hover:bg-[#1a1a24]',\n            )}\n          >\n            <span>{item.icon}</span>\n            <span>{item.label}</span>\n          </button>\n        ))}\n      </nav>\n    </aside>\n  )\n}\n","path":"/Users/alessio/.openclaw/workspace/ensoria-ui/src/components/layout/Sidebar.tsx"}},{"type":"toolCall","id":"call_01_fs2KHA29ul9qp811rf6U3151","name":"write","arguments":{"content":"import { Button } from '../ui/button'\n\nexport function Header({ userName, onLogout }: { userName: string; onLogout: () => void }) {\n  return (\n    <header className=\"h-14 border-b border-[#2a2a3a] bg-[#13131a] flex items-center justify-between px-6\">\n      <div className=\"flex items-center gap-2\">\n        <span className=\"text-xs text-[#9898b0]\">ensoria.local</span>\n      </div>\n      <div className=\"flex items-center gap-3\">\n        <span className=\"text-sm text-[#e4e4ec]\">{userName}</span>\n        <Button variant=\"ghost\" size=\"sm\" onClick={onLogout}>Logout</Button>\n      </div>\n    </header>\n  )\n}\n","path":"/Users/alessio/.openclaw/workspace/ensoria-ui/src/components/layout/Header.tsx"}},{"type":"toolCall","id":"call_02_UgFioP4vOhve3zOL4Dy14001","name":"write","arguments":{"content":"import React, { useEffect } from 'react'\nimport { useNavigate, useLocation, Outlet } from 'react-router-dom'\nimport { useAuthStore } from '../../stores/authStore'\nimport { Sidebar } from './Sidebar'\nimport { Header } from './Header'\nimport { LoadingSpinner } from '../shared/LoadingSpinner'\n\nexport function ProtectedRoute() {\n  const { isAuthenticated, isLoading, checkAuth } = useAuthStore()\n  const navigate = useNavigate()\n\n  useEffect(() => {\n    checkAuth()\n  }, [checkAuth])\n\n  useEffect(() => {\n    if (!isLoading && !isAuthenticated) navigate('/login', { replace: true })\n  }, [isLoading, isAuthenticated, navigate])\n\n  if (isLoading) return <LoadingSpinner size=\"lg\" />\n  if (!isAuthenticated) return null\n\n  return <Outlet />\n}\n\nexport function AppLayout() {\n  const navigate = useNavigate()\n  const location = useLocation()\n  const { user, logout } = useAuthStore()\n\n  const handleNavigate = (path: string) => navigate(path)\n  const handleLogout = () => { logout(); navigate('/login') }\n\n  return (\n    <div className=\"flex h-screen bg-[#0a0a0f]\">\n      <Sidebar currentPath={location.pathname} onNavigate={handleNavigate} />\n      <div className=\"flex-1 flex flex-col overflow-hidden\">\n        <Header userName={user?.name || 'User'} onLogout={handleLogout} />\n        <main className=\"flex-1 overflow-auto p-6\">\n          <Outlet />\n        </main>\n      </div>\n    </div>\n  )\n}\n","path":"/Users/alessio/.openclaw/workspace/ensoria-ui/src/components/layout/AppLayout.tsx"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-flash","usage":{"input":575,"output":1160,"cacheRead":101504,"cacheWrite":0,"totalTokens":103239,"cost":{"input":0.0000805,"output":0.00032480000000000003,"cacheRead":0.002842112,"cacheWrite":0,"total":0.003247412}},"stopReason":"toolUse","timestamp":1777795497477,"responseId":"41a533de-e2b7-48a6-841d-c05f704dca94"}}
