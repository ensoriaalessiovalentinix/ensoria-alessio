{"type":"message","id":"491ad53d","parentId":"0e20506c","timestamp":"2026-05-03T07:49:10.963Z","message":{"role":"assistant","content":[{"type":"thinking","thinking":"Now let me create the Prisma schema and install the devDependencies.","thinkingSignature":"reasoning_content"},{"type":"toolCall","id":"call_00_BfCyyG4lXdsNsYMQg8Tp3017","name":"write","arguments":{"path":"/Users/alessio/.openclaw/workspace/ensoria-api/prisma/schema.prisma","content":"datasource db {\n  provider = \"sqlite\"\n  url      = env(\"DATABASE_URL\")\n}\n\ngenerator client {\n  provider = \"prisma-client-js\"\n}\n\nmodel User {\n  id        String   @id @default(cuid())\n  email     String   @unique\n  password  String\n  name      String\n  role      String   @default(\"admin\")\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n}\n\nmodel People {\n  id        String   @id @default(cuid())\n  type      String   @default(\"client\")\n  name      String\n  email     String?\n  phone     String?\n  company   String?\n  stage     String   @default(\"Contact\")\n  notes     String?\n  tags      String   @default(\"\")\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n\n  projects   Project[]\n  activities Activity[]\n}\n\nmodel Project {\n  id          String   @id @default(cuid())\n  name        String\n  description String?\n  stage       String   @default(\"Contact\")\n  value       Float?\n  peopleId    String\n  people      People   @relation(fields: [peopleId], references: [id], onDelete: Cascade)\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n\n  conversations Conversation[]\n  files         ProjectFile[]\n  requirements  Requirement[]\n  milestones    Milestone[]\n  collaborators Collaborator[]\n  plans         ProjectPlan[]\n  analytics     AnalyticsRecord[]\n}\n\nmodel Conversation {\n  id        String   @id @default(cuid())\n  projectId String\n  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  channel   String   @default(\"manual\")\n  direction String   @default(\"inbound\")\n  subject   String?\n  content   String\n  metadata  String?\n  sentiment Float?\n  createdAt DateTime @default(now())\n}\n\nmodel ProjectFile {\n  id        String   @id @default(cuid())\n  projectId String\n  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  name      String\n  url       String\n  type      String   @default(\"file\")\n  mimeType  String?\n  size      Int?\n  createdAt DateTime @default(now())\n}\n\nmodel Requirement {\n  id          String   @id @default(cuid())\n  projectId   String\n  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  title       String\n  description String?\n  category    String   @default(\"requirement\")\n  status      String   @default(\"open\")\n  priority    String   @default(\"medium\")\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n}\n\nmodel Milestone {\n  id          String   @id @default(cuid())\n  projectId   String\n  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  title       String\n  description String?\n  dueDate     DateTime?\n  status      String   @default(\"pending\")\n  createdAt   DateTime @default(now())\n  updatedAt   DateTime @updatedAt\n}\n\nmodel Collaborator {\n  id        String   @id @default(cuid())\n  projectId String\n  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  name      String\n  email     String?\n  phone     String?\n  role      String?\n  notes     String?\n  createdAt DateTime @default(now())\n}\n\nmodel ProjectPlan {\n  id        String   @id @default(cuid())\n  projectId String\n  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  title     String\n  content   String\n  version   Int      @default(1)\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n}\n\nmodel AnalyticsRecord {\n  id              String   @id @default(cuid())\n  projectId       String\n  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)\n  sentimentScore  Float?\n  alignmentScore  Float?\n  healthScore     Float?\n  engagementScore Float?\n  rawData         String?\n  generatedAt     DateTime @default(now())\n}\n\nmodel Activity {\n  id          String   @id @default(cuid())\n  peopleId    String?\n  people      People?  @relation(fields: [peopleId], references: [id], onDelete: SetNull)\n  projectId   String?\n  type        String   @default(\"created\")\n  description String\n  metadata    String?\n  createdAt   DateTime @default(now())\n}\n"}}],"api":"openai-completions","provider":"deepseek","model":"deepseek-v4-flash","usage":{"input":106,"output":1114,"cacheRead":69760,"cacheWrite":0,"totalTokens":70980,"cost":{"input":0.00001484,"output":0.00031192000000000004,"cacheRead":0.00195328,"cacheWrite":0,"total":0.00228004}},"stopReason":"toolUse","timestamp":1777794535161,"responseId":"27ce96a4-dd0f-499e-8c2b-6ee29253b1af"}}
