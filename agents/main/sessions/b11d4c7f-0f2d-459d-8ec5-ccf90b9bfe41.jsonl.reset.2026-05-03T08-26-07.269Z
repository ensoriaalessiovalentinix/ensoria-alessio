essio/.openclaw/workspace/ensoria-ui/src/components/ui/card.tsx"}},{"type":"toolCall","id":"call_04_czJfb2utQozAhrZITHvq7588","name":"write","arguments":{"content":"import { cn } from '../../lib/utils'\n\nexport function Badge({ className, children }: { className?: string; children: React.ReactNode }) {\n  return (\n    <span className={cn('inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium', className)}>\n      {children}\n    </span>\n  )\n}\n","path":"/Users/alessio/.openclaw/workspace/ensoria-ui/src/components/ui/badge.tsx"}},{"type":"toolCall","id":"call_05_FbPoZ9fkYNPGCDy7VnQ65825","name":"write","arguments":{"content":"import React, { useEffect, useRef } from 'react'\nimport { cn } from '../../lib/utils'\n\nexport function Dialog({\n  open,\n  onClose,\n  title,\n  children,\n}: {\n  open: boolean\n  onClose: () => void\n  title?: string\n  children: React.ReactNode\n}) {\n  const ref = useRef<HTMLDivElement>(null)\n\n  useEffect(() => {\n    if (!open) return\n    const handler = (e: KeyboardEvent) => { if (e.key === 'Escape') onClose() }\n    document.addEventListener('keydown', handler)\n    return () => document.removeEventListener('keydown', handler)\n  }, [open, onClose])\n\n  if (!open) return null\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/60\" onClick={onClose}>\n      <div\n        ref={ref}\n        className=\"w-full max-w-md rounded-xl border border-[#2a2a3a] bg-[#13131a] p-6 shadow-2xl\"\n        onClick={(e) => e.stopPropagation()}\n      >\n        {title && <h2 className=\"mb-4 text-lg font-semibold text-[#e4e4ec]\">{title}</h2>}\n        {children}\n      </div>\n    </div>\n  )\n}\n","path":"/Users/alessio/.openclaw/workspace/ensoria-ui/src/components/ui/dialog.tsx"}},{"type":"toolCall","id":"call_06_ToItmpfhlynwVZS4uG2G1920","name":"write","arguments":{"content":"import React from 'react'\nimport { cn } from '../../lib/utils'\n\nexport function Select({\n  value,\n  onChange,\n  options,\n  className,\n}: {\n  value: string\n  onChange: (v: string) => void\n  options: { label: string; value: string }[]\n  className?: string\n}) {\n  return (\n    <select\n      className={cn(\n        'w-full rounded-lg border border-[#2a2a3a] bg-[#13131a] px-3 py-2 text-sm text-[#e4e4ec] focus:outline-none focus:border-violet-500 transition-colors',\n        className,\n      )}\n      value={value}\n      onChange={(e) => onChange(e.target.value)}\n    >\n      {options.map((opt) => (\n        <option key={opt.value} value={opt.value}>{opt.label}</option>\n      ))}\n    </select>\n  )\n}\n","path":"/Users/alessio/.openclaw/workspace/ensoria-ui/src/components/ui/select.tsx"}},{"type":"toolCall","id":"call_07_I9siM416FK5bX63QOJrf0600","name":"write","arguments":{"content":"import React from 'react'\nimport { cn } from '../../lib/utils'\n\nexport function Tabs({\n  value,\n  onChange,\n  tabs,\n}: {\n  value: string\n  onChange: (v: string) => void\n  tabs: { value: string; label: string }[]\n}) {\n  return (\n    <div className=\"flex gap-1 border-b border-[#2a2a3a] pb-px\">\n      {tabs.map((tab) => (\n        <button\n          key={tab.value}\n          onClick={() => onChange(tab.value)}\n          className={cn(\n            'px-4 py-2 text-sm font-medium transition-colors rounded-t-lg',\n            value === tab.value\n              ? 'text-violet-400 border-b-2 border-violet-400'\n              : 'text-[#9898b0] hover:text-[#e4e4ec]',\n          )}\n        >\n          {tab.label}\n        </button>\n      ))}\n    </div>\n  )\n}\n","path":"/Users/alessio/.openclaw/workspace/ensoria-ui/src/components/ui/tabs.tsx"}},{"type":"toolCall","id":"call_08_ZfCSCoAakM6P8caci2Ad6007","name":"write","arguments":{"content":"import { cn } from '../../lib/utils'\n\nexport function Table({ className, ...props }: React.HTMLAttributes<HTMLTableElement>) {\n  return (\n    <div className=\"w-full overflow-auto\">\n      <table className={cn('w-full tex